@page
@model webShell.Pages.LoginModel
@{
    ViewData["Title"] = "登录";
}
<div class="login-page">
    <form method="post">
        <h1>Shell 控制台</h1>
        <label asp-for="Password">密码</label>
        <input asp-for="Password" type="password" autofocus />
        <button type="submit">登录</button>
        @if (Model.Error is not null)
        {
            <div class="error-output">@Model.Error</div>
        }
    </form>
</div>
